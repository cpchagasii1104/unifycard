NODE_ENV=development
PORT=3000
# Se a senha contiver `#`, cite o URL inteiro: DATABASE_URL="postgresql://..."
# (dotenv trunca em `#` sem aspas; migrate.ts reforça leitura da linha completa.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_BASE64

# Rotas marketplace que usam pedido/checkout em Map (facade). Por defeito desligado — usar intent + orderService + modules/pdv.
# MARKETPLACE_LEGACY_MEMORY_ORDER_ROUTES=true

# Redis / BullMQ (fila payment-events). Sem Redis local: REDIS_ENABLED=false evita tentativas de conexão no boot.
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# Campanhas de procurement (intenção logística; sem dinheiro). Por defeito desligado — sem rotas HTTP.
# ENABLE_PROCUREMENT_CAMPAIGN=true

# Marketplace: fundo regional + compensação de recurso passam a usar Bank (ledger) como SSOT.
# Por defeito desligado — não altera `regional_funds.total_balance_cents` nem cria movimentos reais até ativar.
# USE_BANK_REGIONAL_FUND=true

# Scripts E2E (dev): tenant por defeito nos scripts de checklist; ver src/scripts/e2e-incentive-bank-checklist.ts
# E2E_TENANT_ID=fbe13b78-4516-493d-905a-363796aea1d1
# DEV ONLY — NUNCA em production nem staging: desactiva trg_check_coverage em bank_ledger durante o checklist se COVERAGE_EXCEEDED bloquear.
# loadBackendEnv() (pool, BOOT, scripts) lança erro se NODE_ENV é production ou staging e esta flag estiver true.
# E2E_RELAX_BANK_COVERAGE=true

# Escrow → bank (Fase 1): `releasePayment` / `refundFunds` chamam `bankTransactionService.transfer` antes de persistir
# `escrow_transactions` com `bank_transaction_id`. Requer saldo na conta bank `owner_type=escrow` + `toBankAccountId` no input.
# Por defeito desligado — comportamento legado (só tabela escrow) mantém-se.
# ESCROW_BANK_BRIDGE=true

# Fase 2 — leitura: GET escrow / listagens usam saldo `bank_ledger` na conta custody (`owner_type=escrow`) para `heldAmountCents`;
# `financialPosition` inclui legacy + divergência; log `escrow_read_divergence_detected` se legacy ≠ bank.
# Por defeito desligado.
# ESCROW_READ_FROM_BANK=true

# Authority mode (C55): controla fail-closed vs fail-open quando dados ATL/KYC/GUARDA ausentes.
# - 'strict' (default): ausência de dados = BLOQUEIO. Produção e primeiros usuários reais.
# - 'permissive': ausência de dados = SKIP com log. EXCLUSIVAMENTE dev em sistema vazio.
# Ref: AUTHORITY_PRECEDENCE.md §2, §4.1. Requer NODE_ENV=development para permitir 'permissive'.
# AUTHORITY_MODE=permissive

# Autocomplete de CEP: 'brasilapi' | 'viacep' | vazio (Null, sem rede — default seguro p/ testes)
CEP_PROVIDER=brasilapi
