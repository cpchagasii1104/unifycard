{
  "name": "unificard-backend",
  "version": "1.0.0",
  "description": "Unificard - Backend Kernel + Plugins Architecture",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "tsx watch BOOT.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:check": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "tsx src/core/db/migrate.ts",
    "baseline:migrations": "tsx src/scripts/baseline-migrations.ts",
    "reset:database": "tsx src/scripts/reset-database-complete.ts",
    "seed": "tsx src/core/db/seed.ts",
    "seed:dev:tenant": "tsx src/scripts/seed-dev-tenant.ts",
    "seed:dev:user": "tsx src/scripts/seed-dev-user.ts",
    "seed:dev:actor": "tsx src/scripts/seed-dev-actor.ts",
    "seed:dev:categories": "tsx src/scripts/seed-dev-categories.ts",
    "seed:dev:groups": "tsx src/scripts/seed-dev-groups.ts",
    "seed:dev:complete": "tsx src/scripts/seed-dev-complete.ts",
    "seed:dev": "pnpm seed:dev:tenant && pnpm seed:dev:user && pnpm seed:dev:actor && pnpm seed:dev:categories",
    "verify:dev:user": "tsx src/scripts/verify-dev-user.ts",
    "test:dev:login": "tsx src/scripts/test-dev-login.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/smoke",
    "test:invariants": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/invariants",
    "test:invariants:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/invariants --ci --bail --maxWorkers=1",
    "test:ssot": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/core/categories/__tests__/ssot.test.ts",
    "test:permissions": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/core/tenants/__tests__/tenant-context-permissions.test.ts",
    "check:migrations": "node scripts/check-migration-numbering.js",
    "validate:core-only": "tsx src/scripts/validate-core-only.ts",
    "validate:architectural": "node scripts/validate-architectural-rules.ts",
    "validate:schema-invariants": "tsx scripts/validate-schema-invariants.ts",
    "validate:canonical-logging": "tsx scripts/validate-canonical-logging.ts",
    "simulate:forensics-incident": "tsx scripts/simulate-forensics-incident.ts",
    "analyze:query-plans": "tsx scripts/analyze-query-plans.ts",
    "test:event-replay": "tsx scripts/test-event-replay.ts",
    "check:fastify-schema": "node scripts/check-fastify-schema.js",
    "check:economy-imports": "node scripts/check-economy-imports.js",
    "validate:financial-vocabulary": "node scripts/validate-financial-vocabulary.js",
    "validate:financial-ssot": "node scripts/validate-financial-ssot.js",
    "check:core-imports": "node scripts/check-core-imports.js",
    "check:relative-imports": "bash scripts/check-relative-imports.sh",
    "check:decision-core": "node scripts/check-decision-core.js",
    "check:financial-core": "node scripts/check-financial-core.js",
    "check:financial-invariants": "tsx scripts/check-financial-invariants.ts",
    "violations:list": "grep -r \"from ['\"]@modules/\" src/core/ || echo \"Nenhuma violação encontrada\""
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^6.12.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "stripe": "^20.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0"
}
