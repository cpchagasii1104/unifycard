# Variáveis de ambiente para desenvolvimento local
# NUNCA commitar este arquivo com valores reais de produção

NODE_ENV=development
PORT=3000

# JWT secret apenas para desenvolvimento (>= 32 chars)
JWT_SECRET=dev-secret-key-placeholder-min-32-chars-required

# PostgreSQL local (credenciais válidas)
DATABASE_URL=postgresql://postgres:21estePDZ...@localhost:5432/unificard_dev
