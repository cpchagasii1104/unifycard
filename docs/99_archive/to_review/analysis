### Solução 2: Validar Dados ANTES de Completar Onboarding

**Arquivo**: `frontend/src/components/Profile.tsx` (linha 1260)

**ANTES**:
```typescript
// Completar onboarding após salvar
if (!onboardingCompleted && canEditPersonalData) {
  await completeOnboarding();
  // ...
}
```

**DEPOIS**:
```typescript
// 🔴 CORREÇÃO: Verificar se birthdate foi salvo ANTES de completar onboarding
if (!onboardingCompleted && canEditPersonalData) {
  try {
    // Recarregar identity para verificar se birthdate foi persistido
    const reloadedIdentity = await getIdentityProfile();
    const birthdateSaved = reloadedIdentity.global?.birthdate !== null && reloadedIdentity.global?.birthdate !== undefined;

    if (!birthdateSaved) {
      console.error('[Profile] ❌ birthdate não foi salvo. NÃO completando onboarding.');
      throw new Error('Data de nascimento não foi salva corretamente. Tente novamente.');
    }

    // Só completar se todos os dados obrigatórios foram salvos
    await completeOnboarding();
    console.log('[Profile] ✅ Onboarding concluído com sucesso');

    // Recarregar perfil do backend
    const reloadedCoreProfile = await getCoreProfile();
    const metadata = reloadedCoreProfile.personal_profile?.metadata || {};
    const onboardingStatus = metadata.onboarding_completed === true;

    setOnboardingCompleted(onboardingStatus);
    setCanEditPersonalData(!onboardingStatus);
    setShowOnboardingModal(false);
  } catch (onboardingErr) {
    console.error('[Profile] Erro ao completar onboarding:', onboardingErr);
    // NÃO marcar como concluído se houver erro
    throw onboardingErr;
  }
}
```

