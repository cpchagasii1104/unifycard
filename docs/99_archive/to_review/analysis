### Solução 3: Adicionar Validação no Backend (completeOnboarding)

**Arquivo**: `backend/src/core/profile/profile.service.ts` (linha 358)

**ANTES**:
```typescript
async completeOnboarding(tenantId: string, userId: string): Promise<Profile> {
  const existingProfile = await this.getProfile(tenantId, userId);
  const existingMetadata = existingProfile?.metadata || {};

  const updatedMetadata = {
    ...existingMetadata,
    onboarding_completed: true,
    onboarding_completed_at: new Date().toISOString(),
  };

  return this.upsertProfile(tenantId, userId, {
    metadata: updatedMetadata,
  });
}
```

**DEPOIS**:
```typescript
async completeOnboarding(tenantId: string, userId: string): Promise<Profile> {
  // 🔴 VALIDAÇÃO CRÍTICA: Verificar se dados obrigatórios foram preenchidos
  const { identityService } = await import('@core/identity/identity.service');

  // Buscar global_user_id
  const userLink = await runQueryWithTenant<{ global_user_id: string }>(
    tenantId,
    `SELECT global_user_id FROM users WHERE user_id = $1 LIMIT 1`,
    [userId]
  );

  if (!userLink || !userLink.global_user_id) {
    throw new Error('Usuário não possui identidade global');
  }

  const globalUser = await identityService.getGlobalIdentity(userLink.global_user_id);

  // Validar dados obrigatórios
  const errors: string[] = [];

  if (!globalUser?.fullName || globalUser.fullName.trim().length === 0) {
    errors.push('Nome completo é obrigatório');
  }

  if (!globalUser?.birthdate) {
    errors.push('Data de nascimento é obrigatória');
  }

  // Verificar gender em metadata
  const existingProfile = await this.getProfile(tenantId, userId);
  const gender = existingProfile?.metadata?.gender;

  if (!gender || (gender !== 'male' && gender !== 'female')) {
    errors.push('Gênero é obrigatório');
  }

  if (errors.length > 0) {
    throw new Error(`Não é possível completar onboarding. Dados faltando: ${errors.join(', ')}`);
  }

  // Todos os dados estão OK, pode completar
  const existingMetadata = existingProfile?.metadata || {};

  const updatedMetadata = {
    ...existingMetadata,
    onboarding_completed: true,
    onboarding_completed_at: new Date().toISOString(),
  };

  return this.upsertProfile(tenantId, userId, {
    metadata: updatedMetadata,
  });
}
```

